# Set this to the deployed public HTTPS address for share links, e.g. https://example.com/
# Leave blank to use the address currently open in the browser.
VITE_PUBLIC_APP_URL=

# Public Firebase Web App configuration (safe to expose in the browser).
# Copy these values from Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
